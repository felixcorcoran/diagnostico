---
import { paths, site as siteFor } from '../data/site';
import { textos } from '../data/textos';
import type { Lang } from '../data/senales';

const { lang } = Astro.props as { lang: Lang };
const site = siteFor(lang);
const t = textos[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
---

<!-- La firma de felixcorcoran.es: la marca de eje a eje y la letra pequeña.
     Sin la escena de pantalla entera de la landing: aquí tiene que caber
     todo en una pantalla al entrar. -->
<footer class="footer">
	<div class="inner">
		<p class="brand" aria-hidden="true">
			<span class="brand-first">felix</span><span class="brand-last">corcoran</span>
		</p>
		<div class="fine">
			<a class="foot-cta" href={site.contact} data-site-link>
				{t.ctaLink}
				<svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M1.5 6h9M7 2.5 10.5 6 7 9.5"></path></svg>
			</a>
			<a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
			<!-- La otra herramienta gratuita de felixcorcoran.es -->
			<a class="mail" href={site.subvenciones} hreflang="es" data-site-link>{t.footer.subvenciones}</a>
			<span class="legal">
				<a href={site.legal} hreflang="es" data-site-link>{t.footer.legal}</a>
				<a href={site.privacy} hreflang="es" data-site-link>{t.footer.privacy}</a>
				<a href={paths[other]} hreflang={other} lang={other}>{t.footer.other}</a>
			</span>
		</div>
	</div>
</footer>

<style>
	.inner {
		box-sizing: border-box;
		width: calc(100% - 2 * var(--gutter));
		margin-inline: auto;
		padding: clamp(0.75rem, 4svh, 3rem) var(--frame-pad) clamp(0.75rem, 3svh, 2.25rem);
		container-type: inline-size;
	}

	/* «felixcorcoran» mide 6.16em: así ocupa justo el ancho de la columna.
	   En pantallas anchas y bajas, el alto manda (si no, obligaría a hacer
	   scroll al entrar). */
	.brand {
		--brand-em: 6.16;

		margin: 0 0 clamp(0.5rem, 2.5svh, 2rem);
		font-size: min(100cqw / var(--brand-em), 21svh);
		line-height: 0.8;
		letter-spacing: -0.045em;
		white-space: nowrap;
		user-select: none;
	}

	.brand-first {
		font-weight: 300;
		color: rgb(var(--ink) / 0.82);
	}

	.brand-last {
		font-weight: 600;
	}

	.fine {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem clamp(1.5rem, 3vw, 2.5rem);
	}

	/* La CTA, subrayada en coral; el correo, a su lado; lo legal, a la derecha */
	.foot-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		padding-block: 0.4rem;
		font-size: 1rem;
		letter-spacing: -0.01em;
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: max(1px, 0.07em);
		text-underline-offset: 0.3em;
	}

	.foot-cta svg {
		width: 0.75em;
		height: 0.75em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: translate 0.3s var(--ease-out);
	}

	:global([data-theme="dark"]) .foot-cta svg {
		color: var(--accent);
	}

	@media (prefers-reduced-motion: no-preference) {
		.foot-cta:hover svg {
			translate: 0.15em 0;
		}
	}

	.mail {
		font-size: 0.875rem;
		padding-block: 0.4rem;
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: rgb(var(--ink) / 0.25);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.3em;
		transition: text-decoration-color 0.3s var(--ease-out);
	}

	.mail:hover {
		text-decoration-color: currentColor;
	}

	.legal {
		display: flex;
		gap: 1.25rem;
		margin-left: auto;
	}

	.legal a {
		padding-block: 0.4rem;
		white-space: nowrap;
		font-size: 0.8125rem;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.3s var(--ease-out);
	}

	.legal a:hover {
		color: var(--text);
	}

	/* Móvil: la firma del ancho de la pantalla; la letra pequeña, en una
	   columna compacta para que todo quepa sin scroll */
	@media (max-width: 40rem) {
		.inner {
			padding-inline: 0;
		}

		.fine {
			margin-inline: var(--frame-pad);
			gap: 0 1.25rem;
		}

		.foot-cta,
		.mail,
		.legal a {
			padding-block: 0.25rem;
		}

		.legal {
			margin-left: 0;
			flex-wrap: wrap;
			column-gap: 1.25rem;
		}
	}
</style>
