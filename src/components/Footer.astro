---
import { paths, site as siteFor } from '../data/site';
import { textos } from '../data/textos';
import type { Lang } from '../data/senales';

const { lang } = Astro.props as { lang: Lang };
const site = siteFor(lang);
const t = textos[lang].footer;
const other: Lang = lang === 'es' ? 'en' : 'es';
---

<!-- Pie corto: una línea con la web, las legales y el otro idioma. La firma
     grande de la landing obligaría a hacer scroll en una página que cabe en
     una pantalla. -->
<footer class="foot">
	<a href={site.home} data-site-link>felixcorcoran.es</a>
	<a href={site.legal} hreflang="es" data-site-link>{t.legal}</a>
	<a href={site.privacy} hreflang="es" data-site-link>{t.privacy}</a>
	<a class="lang" href={paths[other]} hreflang={other} lang={other}>{t.other}</a>
</footer>

<style>
	.foot {
		box-sizing: border-box;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		width: min(100% - 2 * var(--gutter), 46rem);
		margin-inline: auto;
		padding-block: 1.25rem;
		border-top: 1px solid var(--rule);
		font-size: 0.8125rem;
	}

	.foot a {
		padding-block: 0.4rem;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.3s var(--ease-out);
	}

	.foot a:hover {
		color: var(--text);
	}

	.lang {
		margin-left: auto;
	}
</style>
