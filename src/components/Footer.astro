---
import { site } from '../data/site';
---

<!-- La firma de felixcorcoran.es, en corto: sin escena de pantalla entera
     (aquí no hay historia que cerrar), pero con la misma marca de eje a eje
     y la misma letra pequeña. -->
<footer class="footer">
	<div class="inner">
		<p class="brand" aria-hidden="true">
			<span class="brand-first">felix</span><span class="brand-last">corcoran</span>
		</p>
		<div class="fine">
			<a class="cta" href={site.contact} data-site-link>
				Solicitar auditoría gratuita
				<svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M1.5 6h9M7 2.5 10.5 6 7 9.5"></path></svg>
			</a>
			<a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
			<span class="legal">
				<a href={site.home} data-site-link>felixcorcoran.es</a>
				<a href={site.legal} data-site-link>Aviso legal</a>
				<a href={site.privacy} data-site-link>Privacidad</a>
			</span>
		</div>
	</div>
</footer>

<style>
	.inner {
		box-sizing: border-box;
		width: calc(100% - 2 * var(--gutter));
		margin-inline: auto;
		padding: clamp(5rem, 14svh, 9rem) var(--frame-pad) clamp(1.5rem, 4svh, 2.5rem);
		container-type: inline-size;
	}

	/* «felixcorcoran» mide 6.16em: así ocupa justo el ancho de la columna */
	.brand {
		--brand-em: 6.16;

		margin: 0 0 clamp(1.25rem, 4svh, 2.5rem);
		font-size: calc(100cqw / var(--brand-em));
		line-height: 0.8;
		letter-spacing: -0.045em;
		white-space: nowrap;
		user-select: none;
	}

	.brand-first {
		font-weight: 300;
		color: rgb(var(--ink) / 0.82);
	}

	.brand-last {
		font-weight: 600;
	}

	.fine {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem clamp(1.5rem, 3vw, 2.5rem);
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		padding-block: 0.4rem;
		font-size: 1rem;
		letter-spacing: -0.01em;
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: max(1px, 0.07em);
		text-underline-offset: 0.3em;
	}

	.cta svg {
		width: 0.75em;
		height: 0.75em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: translate 0.3s var(--ease-out);
	}

	:global([data-theme="dark"]) .cta svg {
		color: var(--accent);
	}

	@media (prefers-reduced-motion: no-preference) {
		.cta:hover svg {
			translate: 0.15em 0;
		}
	}

	.mail {
		font-size: 0.875rem;
		padding-block: 0.4rem;
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: rgb(var(--ink) / 0.25);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.3em;
		transition: text-decoration-color 0.3s var(--ease-out);
	}

	.mail:hover {
		text-decoration-color: currentColor;
	}

	.legal {
		display: flex;
		gap: 1.25rem;
		margin-left: auto;
	}

	.legal a {
		padding-block: 0.4rem;
		white-space: nowrap;
		font-size: 0.8125rem;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.3s var(--ease-out);
	}

	.legal a:hover {
		color: var(--text);
	}

	@media (max-width: 40rem) {
		.inner {
			padding-inline: 0;
		}

		.fine {
			margin-inline: var(--frame-pad);
			flex-direction: column;
			align-items: flex-start;
		}

		.legal {
			margin-left: 0;
			flex-wrap: wrap;
		}

		.cta,
		.mail,
		.legal a {
			display: inline-flex;
			align-items: center;
			min-height: 2.75rem;
			padding-block: 0;
		}
	}
</style>
