---
import { site } from '../data/site';
---

<!-- La misma píldora que felixcorcoran.es (src/components/Navbar.astro de la
     landing): logo, tema, Trabajo y Contacto. Aquí todos los enlaces llevan
     a la web principal. -->
<header class="nav">
	<nav class="pill" aria-label="Principal">
		<a class="logo" href={site.home} aria-label="felixcorcoran — inicio" data-site-link>
			<span class="logo-first">felix</span><span class="logo-last">corcoran</span>
		</a>
		<ul class="links">
			<li class="theme-item">
				<button class="theme" type="button" aria-pressed="false" aria-label="Modo oscuro" title="Modo oscuro" data-theme-toggle>
					<svg class="moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
					</svg>
					<svg class="sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
					</svg>
				</button>
			</li>
			<li><a href={site.work} data-site-link>Trabajo</a></li>
			<li><a class="highlight" href={site.contact} data-site-link>Contacto</a></li>
		</ul>
	</nav>
</header>

<style>
	.nav {
		position: fixed;
		inset: var(--nav-top) 0 auto;
		z-index: 100;
		pointer-events: none;
	}

	.pill {
		pointer-events: auto;
		box-sizing: border-box;
		width: var(--frame);
		margin-inline: auto;
		height: var(--nav-height);
		padding-inline: var(--frame-pad);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		border-radius: 999px;
		background: rgb(var(--paper) / 0.65);
		border: 1px solid rgb(var(--ink) / 0.06);
		box-shadow:
			inset 0 1px 0 rgb(var(--surface-rgb) / 0.7),
			0 10px 30px -16px rgb(var(--ink) / 0.1);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}

	:global([data-theme="dark"]) .pill {
		background: rgb(var(--surface-rgb) / 0.72);
		border-color: rgb(var(--ink) / 0.12);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.06),
			0 10px 30px -16px rgb(0 0 0 / 0.6);
	}

	.logo {
		font-size: 1.0625rem;
		letter-spacing: -0.025em;
		line-height: 1;
		color: var(--text);
		text-decoration: none;
		white-space: nowrap;
	}

	.logo-first {
		font-weight: 300;
		color: rgb(var(--ink) / 0.82);
	}

	.logo-last {
		font-weight: 600;
	}

	.links {
		display: flex;
		align-items: center;
		gap: clamp(1.5rem, 2.6vw, 2.5rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.theme {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		margin: 0 -0.5rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: none;
		color: var(--text-muted);
		cursor: pointer;
		transition: color 0.25s var(--ease-out);
	}

	.theme:hover {
		color: var(--text);
	}

	.theme svg {
		grid-area: 1 / 1;
		width: 1.0625rem;
		height: 1.0625rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.theme .sun,
	:global([data-theme="dark"]) .theme .moon {
		display: none;
	}

	:global([data-theme="dark"]) .theme .sun {
		display: block;
	}

	.links a {
		font-size: 0.875rem;
		letter-spacing: -0.005em;
		color: var(--text-muted);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.25s var(--ease-out);
	}

	.links a:hover {
		color: var(--text);
	}

	.links a.highlight {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		height: calc(var(--nav-height) - 1rem);
		margin-right: calc(0.5rem - var(--frame-pad));
		padding: 0 0.9rem;
		border-radius: 999px;
		box-shadow: inset 0 0 0 1px rgb(var(--ink) / 0.18);
		color: var(--text);
		transition:
			box-shadow 0.25s var(--ease-out),
			background-color 0.25s var(--ease-out);
	}

	.links a.highlight::before {
		content: "";
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: var(--accent);
	}

	.links a.highlight:hover {
		background-color: rgb(var(--surface-rgb) / 0.7);
		box-shadow: inset 0 0 0 1px rgb(var(--ink) / 0.3);
	}

	@media (max-width: 40rem) {
		.logo {
			font-size: 1rem;
		}

		.links {
			gap: 0.75rem;
		}

		.theme {
			width: 1.75rem;
			margin: 0 -0.375rem 0 -0.625rem;
		}
	}

	@media (max-width: 22.5rem) {
		.pill,
		.links {
			gap: 0.75rem;
		}

		.pill {
			padding-inline: 0.875rem;
		}

		.logo {
			font-size: 0.9375rem;
		}

		.links {
			gap: 0.625rem;
		}

		.theme {
			width: 1.75rem;
			margin: 0 -0.625rem 0 -0.375rem;
		}

		.links a.highlight {
			height: auto;
			margin-right: 0;
			padding: 0;
			box-shadow: none;
		}
	}

	@media (max-width: 21.25rem) {
		.theme-item {
			display: none;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.pill {
			animation: nav-in 1s var(--ease-out) backwards;
		}
	}

	@keyframes nav-in {
		from {
			opacity: 0;
			translate: 0 -0.5rem;
		}
	}
</style>

<script>
	const root = document.documentElement;
	const meta = document.querySelector('[data-theme-color]');
	const isDark = () => root.dataset.theme === 'dark';

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
		const sync = () => button.setAttribute('aria-pressed', String(isDark()));
		sync();
		button.addEventListener('click', () => {
			const dark = !isDark();
			if (dark) root.dataset.theme = 'dark';
			else delete root.dataset.theme;
			meta?.setAttribute('content', dark ? '#131211' : '#FAF9F6');
			try {
				if (dark) localStorage.setItem('tema', 'oscuro');
				else localStorage.removeItem('tema');
			} catch {}
			sync();
		});
	}

	// Los enlaces a felixcorcoran.es se llevan el tema: es otra web (otro
	// origen) y no puede leer lo que se guarda aquí. Se añade al pulsar, así
	// vale también si el tema se cambia después de cargar.
	document.addEventListener('click', (event) => {
		const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-site-link]');
		if (!link) return;
		const url = new URL(link.href);
		url.searchParams.set('tema', isDark() ? 'oscuro' : 'claro');
		link.href = url.href;
	});
</script>
