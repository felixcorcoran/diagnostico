---
import { Font } from 'astro:assets';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

const title = 'Diagnóstico de tu web · felixcorcoran';
const description =
	'Escribe la dirección de tu web y comprueba qué se encuentra un cliente al entrar: si carga, si es segura, si el teléfono se puede pulsar en el móvil. Solo lo que se puede demostrar.';
const canonical = new URL('/', Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="theme-color" content="#FAF9F6" data-theme-color />
		<!-- Claro por defecto, como felixcorcoran.es. Oscuro si se pidió al
		     llegar desde allí (?tema=oscuro, que se recuerda y se quita de la
		     barra) o si se eligió aquí antes. Va antes de pintar: sin destello. -->
		<script is:inline>
			try {
				const url = new URL(location.href);
				const asked = url.searchParams.get('tema');
				if (asked === 'oscuro') localStorage.setItem('tema', 'oscuro');
				if (asked === 'claro') localStorage.removeItem('tema');
				if (asked) {
					url.searchParams.delete('tema');
					history.replaceState(null, '', url.pathname + url.search + url.hash);
				}
				if (asked === 'oscuro' || (!asked && localStorage.getItem('tema') === 'oscuro')) {
					document.documentElement.dataset.theme = 'dark';
					document.querySelector('[data-theme-color]')?.setAttribute('content', '#131211');
				}
			} catch {
				if (location.search.includes('tema=oscuro')) document.documentElement.dataset.theme = 'dark';
			}
		</script>
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="es_ES" />
		<Font cssVariable="--font-sora" preload />
	</head>
	<body>
		<Navbar />

		<main>
			<section class="hero" aria-labelledby="title">
				<p class="eyebrow">Diagnóstico gratuito</p>
				<h1 id="title" class="title">¿Qué encuentra un cliente en tu web?</h1>
				<p class="lead">Escribe la dirección. Se comprueba la portada y solo se dice lo que se puede demostrar.</p>

				<form id="form" class="form" novalidate>
					<div class="field">
						<label for="url">Tu web</label>
						<input
							id="url"
							name="url"
							type="text"
							inputmode="url"
							autocomplete="url"
							autocapitalize="off"
							spellcheck="false"
							placeholder="mipeluqueria.es"
							required
						/>
					</div>
					<button type="submit" id="submit" class="submit">
						Comprobar
						<svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M1.5 6h9M7 2.5 10.5 6 7 9.5"></path></svg>
					</button>
				</form>
				<p id="status" class="status" role="status" aria-live="polite"></p>
				<p class="hint">La dirección que escribes solo se usa para hacer la comprobación. No se guarda.</p>
			</section>

			<section id="result" class="result" aria-labelledby="result-title" hidden>
				<div class="row">
					<span class="row-rule" aria-hidden="true"></span>
					<p class="eyebrow">Resultado</p>
					<div>
						<h2 id="result-title" class="domain"></h2>
						<p id="result-note" class="note"></p>
						<dl id="counts" class="counts"></dl>
					</div>
				</div>

				<div id="groups"></div>

				<div class="row">
					<span class="row-rule" aria-hidden="true"></span>
					<p class="eyebrow">No se ha comprobado</p>
					<ul id="limits" class="limits"></ul>
				</div>

				<div class="row next">
					<span class="row-rule" aria-hidden="true"></span>
					<p class="eyebrow">Siguiente paso</p>
					<div>
						<p class="next-title">Esto es lo que se ve desde fuera.</p>
						<p class="next-text">
							Si quieres que mire tu negocio por dentro, cuéntame un poco de él y qué te gustaría mejorar. Te enseño hasta 3
							oportunidades concretas. Gratis y sin compromiso.
						</p>
						<a class="submit" href={site.contact} data-site-link>
							Solicitar auditoría gratuita
							<svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M1.5 6h9M7 2.5 10.5 6 7 9.5"></path></svg>
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			type Nivel = 'fallo' | 'aviso' | 'bien' | 'neutro';
			interface Hallazgo {
				senal: string;
				nivel: Nivel;
				titulo: string;
				porQue: string;
				hecho: string;
				detalle: string | null;
			}
			interface Respuesta {
				url: string;
				finalUrl: string | null;
				estado: 'ok' | 'down' | 'unverified' | 'blocked';
				hallazgos: Hallazgo[];
				noComprobado: string[];
			}

			const form = document.querySelector<HTMLFormElement>('#form')!;
			const input = document.querySelector<HTMLInputElement>('#url')!;
			const button = document.querySelector<HTMLButtonElement>('#submit')!;
			const status = document.querySelector<HTMLParagraphElement>('#status')!;
			const result = document.querySelector<HTMLElement>('#result')!;

			// Cada nivel, su fila. «Bien» va en corto: es lo que no hay que tocar.
			const GROUPS: { nivel: Nivel; label: string }[] = [
				{ nivel: 'fallo', label: 'Arreglar' },
				{ nivel: 'aviso', label: 'Revisar' },
				{ nivel: 'neutro', label: 'Sin datos' },
				{ nivel: 'bien', label: 'Está bien' },
			];

			const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
				const node = document.createElement(tag);
				if (className) node.className = className;
				if (text) node.textContent = text;
				return node;
			};

			function row(label: string, nivel: Nivel, content: HTMLElement) {
				const wrap = el('div', `row row--${nivel}`);
				const rule = el('span', 'row-rule');
				rule.setAttribute('aria-hidden', 'true');
				const eyebrow = el('p', 'eyebrow');
				eyebrow.append(el('span', `dot dot--${nivel}`), label);
				wrap.append(rule, eyebrow, content);
				return wrap;
			}

			function note(data: Respuesta): string {
				if (data.estado === 'down') return 'La web no carga. Lo demás no se ha podido mirar.';
				if (data.estado === 'unverified' || data.estado === 'blocked') return 'No se ha podido leer la portada.';
				return 'Esto es lo que se ha encontrado en la portada.';
			}

			function render(data: Respuesta) {
				document.querySelector('#result-title')!.textContent = new URL(data.finalUrl ?? data.url).hostname.replace(/^www\./, '');
				document.querySelector('#result-note')!.textContent = note(data);

				const count = (n: Nivel) => data.hallazgos.filter((h) => h.nivel === n).length;
				const counts = document.querySelector('#counts')!;
				counts.replaceChildren();
				if (data.estado === 'ok') {
					for (const [n, label] of [['fallo', 'que arreglar'], ['aviso', 'que revisar'], ['bien', 'bien']] as const) {
						const item = el('div', `count count--${count(n) ? n : 'cero'}`);
						item.append(el('dt', '', label), el('dd', '', String(count(n))));
						counts.append(item);
					}
				}

				const groups = document.querySelector('#groups')!;
				groups.replaceChildren(
					...GROUPS.filter((g) => count(g.nivel) > 0).map(({ nivel, label }) => {
						const list = el('ul', nivel === 'bien' ? 'good' : 'findings');
						for (const h of data.hallazgos.filter((x) => x.nivel === nivel)) {
							const item = el('li', 'finding');
							if (nivel === 'bien') item.append(el('span', 'good-title', h.titulo), el('span', 'good-fact', h.hecho));
							else item.append(el('h3', '', h.titulo), el('p', 'fact', h.hecho), el('p', 'why', h.porQue));
							list.append(item);
						}
						return row(label, nivel, list);
					}),
				);
				document.querySelector('#limits')!.replaceChildren(...data.noComprobado.map((t) => el('li', '', t)));

				result.hidden = false;
				result.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const url = input.value.trim();
				status.classList.remove('is-busy', 'is-error');
				if (!url) {
					status.classList.add('is-error');
					status.textContent = 'Escribe la dirección de tu web, por ejemplo mipeluqueria.es.';
					input.focus();
					return;
				}
				button.disabled = true;
				form.setAttribute('aria-busy', 'true');
				result.hidden = true;
				status.classList.add('is-busy');
				status.textContent = `Comprobando ${url}… Suele tardar unos segundos.`;
				try {
					const res = await fetch('/api/diagnostico', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ url }),
					});
					const data = await res.json();
					if (!res.ok) throw new Error(data.error ?? 'No se ha podido hacer la comprobación.');
					status.textContent = '';
					render(data as Respuesta);
				} catch (err) {
					status.classList.add('is-error');
					status.textContent =
						err instanceof TypeError ? 'No se ha podido conectar. Revisa tu conexión y vuelve a probar.' : (err as Error).message;
				} finally {
					status.classList.remove('is-busy');
					button.disabled = false;
					form.removeAttribute('aria-busy');
				}
			});
		</script>

		<style is:global>
			main {
				flex: 1;
			}

			/* ---------- Entrada: como /contacto ----------
			   Grande y breve: la página dice dónde estás de un vistazo */
			.hero {
				box-sizing: border-box;
				width: var(--frame);
				margin-inline: auto;
				padding: calc(var(--nav-top) + var(--nav-height) + clamp(3.5rem, 12svh, 8rem)) var(--frame-pad)
					clamp(3rem, 8svh, 5rem);
			}

			.hero .eyebrow {
				margin-bottom: clamp(1rem, 2.5svh, 1.5rem);
			}

			.title {
				max-width: 11em;
				margin: 0;
				font-size: clamp(2.75rem, min(5.6vw, 11svh), 5.25rem);
				font-weight: 400;
				line-height: 1;
				letter-spacing: -0.04em;
				text-wrap: balance;
			}

			.lead {
				max-width: 24em;
				margin: clamp(1.75rem, 4svh, 2.5rem) 0 0;
				font-size: clamp(1.125rem, 0.95rem + 0.5vw, 1.375rem);
				line-height: 1.45;
				letter-spacing: -0.01em;
				text-wrap: pretty;
			}

			/* El campo, como los del formulario de /contacto: una línea, sin caja.
			   El botón coral, el mismo que «Enviar solicitud». */
			.form {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				align-items: end;
				gap: 1.5rem;
				max-width: 44rem;
				margin-top: clamp(2.5rem, 6svh, 3.5rem);
			}

			.field {
				display: grid;
				gap: 0.35rem;
			}

			.field label {
				font-size: 0.8125rem;
				font-weight: 500;
				letter-spacing: 0.01em;
				color: var(--text-muted);
			}

			.field input {
				width: 100%;
				box-sizing: border-box;
				padding: 0.5rem 0;
				border: 0;
				border-bottom: 1px solid rgb(var(--ink) / 0.42);
				border-radius: 0;
				background: transparent;
				color: var(--text);
				font: inherit;
				font-size: clamp(1.25rem, 1rem + 0.8vw, 1.625rem);
				font-weight: 400;
				letter-spacing: -0.02em;
				transition: border-color 0.3s var(--ease-out);
			}

			.field input::placeholder {
				color: rgb(var(--ink) / 0.3);
			}

			.field input:focus {
				outline: none;
				border-bottom-color: var(--accent);
				box-shadow: 0 1px 0 var(--accent);
			}

			.submit {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.5em;
				min-height: 3.5rem;
				padding: 0 1.75rem;
				border: 0;
				border-radius: 999px;
				background: var(--accent);
				color: var(--text);
				font: inherit;
				font-size: 1rem;
				font-weight: 500;
				text-decoration: none;
				white-space: nowrap;
				cursor: pointer;
				transition: box-shadow 0.4s var(--ease-out);
			}

			.submit:hover {
				box-shadow: 0 0 0 0.4rem var(--accent-soft);
			}

			.submit:disabled {
				cursor: progress;
				opacity: 0.6;
				box-shadow: none;
			}

			.submit svg {
				width: 0.75em;
				height: 0.75em;
				fill: none;
				stroke: currentColor;
				stroke-width: 1.4;
				stroke-linecap: round;
				stroke-linejoin: round;
				transition: translate 0.3s var(--ease-out);
			}

			.submit:hover svg {
				translate: 0.15em 0;
			}

			.status {
				max-width: 44rem;
				margin: 1.25rem 0 0;
				font-size: 0.9375rem;
				line-height: 1.5;
			}

			.status:empty {
				display: none;
			}

			/* Mientras comprueba: el punto coral de la marca, latiendo */
			.status.is-busy {
				display: flex;
				align-items: baseline;
				gap: 0.6rem;
				color: var(--text-muted);
			}

			.status.is-busy::before {
				content: "";
				flex: none;
				width: 0.5rem;
				height: 0.5rem;
				border-radius: 50%;
				background: var(--accent);
				animation: pulse 1.2s var(--ease-out) infinite;
			}

			.status.is-error {
				color: var(--accent-text);
			}

			@keyframes pulse {
				50% {
					opacity: 0.25;
					scale: 0.7;
				}
			}

			.hint {
				max-width: 44rem;
				margin: 1rem 0 0;
				font-size: 0.8125rem;
				color: var(--text-muted);
			}

			/* ---------- Resultado: las filas de índice de la landing ----------
			   Etiqueta en el eje, contenido en la columna del texto y una línea
			   finísima encima */
			.result {
				box-sizing: border-box;
				width: var(--frame);
				margin-inline: auto;
				padding: 0 var(--frame-pad);
				scroll-margin-top: calc(var(--nav-top) + var(--nav-height) + 1rem);
			}

			.row {
				position: relative;
				display: grid;
				grid-template-columns: var(--label-col) minmax(0, 1fr);
				column-gap: var(--col-gap);
				padding-block: clamp(2rem, 6svh, 3.5rem);
			}

			.row > .eyebrow {
				display: flex;
				align-items: center;
				gap: 0.6em;
				align-self: start;
				padding-top: 0.6em;
			}

			.row-rule {
				position: absolute;
				inset: 0 0 auto;
				height: 1px;
				background: var(--rule);
			}

			.dot {
				flex: none;
				width: 0.45rem;
				height: 0.45rem;
				border-radius: 50%;
			}

			.dot--fallo {
				background: var(--accent);
			}

			.dot--aviso {
				box-shadow: inset 0 0 0 1.5px var(--accent);
			}

			.dot--neutro {
				box-shadow: inset 0 0 0 1.5px var(--text-muted);
			}

			.dot--bien {
				background: rgb(var(--ink) / 0.35);
			}

			.row--fallo > .eyebrow {
				color: var(--accent-text);
			}

			.domain {
				margin: 0;
				font-size: clamp(2rem, 4.5vw, 3.5rem);
				font-weight: 400;
				line-height: 1.05;
				letter-spacing: -0.035em;
				overflow-wrap: anywhere;
			}

			.note {
				margin: 0.75rem 0 0;
				color: var(--text-muted);
			}

			/* El resumen en tres números grandes, como los del método de la
			   auditoría. Lo que hay que arreglar, en coral. */
			.counts {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem clamp(2rem, 6vw, 4.5rem);
				margin: clamp(1.75rem, 4svh, 2.5rem) 0 0;
			}

			.counts:empty {
				display: none;
			}

			.count {
				display: flex;
				flex-direction: column-reverse;
				gap: 0.4rem;
			}

			.count dd {
				margin: 0;
				font-size: clamp(3rem, 7vw, 5rem);
				font-weight: 300;
				line-height: 0.9;
				letter-spacing: -0.04em;
				font-variant-numeric: tabular-nums;
			}

			.count dt {
				font-size: 0.8125rem;
				font-weight: 500;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--text-muted);
			}

			.count--fallo dd {
				color: var(--accent);
			}

			.count--bien dd,
			.count--cero dd {
				color: rgb(var(--ink) / 0.4);
			}

			.findings,
			.good,
			.limits {
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.findings .finding + .finding {
				margin-top: clamp(1.75rem, 4svh, 2.5rem);
				padding-top: clamp(1.75rem, 4svh, 2.5rem);
				border-top: 1px solid var(--rule);
			}

			.finding h3 {
				margin: 0;
				font-size: clamp(1.25rem, 1rem + 0.8vw, 1.625rem);
				font-weight: 400;
				line-height: 1.2;
				letter-spacing: -0.02em;
			}

			.fact {
				max-width: 34em;
				margin: 0.6rem 0 0;
				font-size: 1.0625rem;
				line-height: 1.5;
			}

			.why {
				max-width: 34em;
				margin: 0.4rem 0 0;
				font-size: 1rem;
				line-height: 1.55;
				color: var(--text-muted);
				text-wrap: pretty;
			}

			/* Lo que está bien: una línea por cosa, sin explicación */
			.good .finding {
				display: grid;
				grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
				gap: 0.25rem 1.5rem;
				padding-block: 0.6rem;
			}

			.good .finding + .finding {
				border-top: 1px solid var(--rule);
			}

			.good-title {
				font-weight: 500;
			}

			.good-fact {
				color: var(--text-muted);
			}

			.limits li {
				position: relative;
				max-width: 36em;
				padding-left: 1.25rem;
				line-height: 1.55;
				color: var(--text-muted);
			}

			.limits li + li {
				margin-top: 0.5rem;
			}

			.limits li::before {
				content: "";
				position: absolute;
				left: 0;
				top: 0.75em;
				width: 0.5rem;
				height: 1px;
				background: currentColor;
			}

			.next-title {
				margin: 0;
				font-size: clamp(1.75rem, 3.5vw, 2.75rem);
				font-weight: 400;
				line-height: 1.1;
				letter-spacing: -0.035em;
				text-wrap: balance;
			}

			.next-text {
				max-width: 30em;
				margin: 1rem 0 clamp(1.75rem, 4svh, 2.25rem);
				font-size: 1.0625rem;
				line-height: 1.55;
				color: var(--text-muted);
				text-wrap: pretty;
			}

			/* ---------- Móvil: una columna ---------- */
			@media (max-width: 48rem), (orientation: portrait) and (max-width: 75rem) {
				.hero {
					padding-top: calc(var(--nav-top) + var(--nav-height) + clamp(2.5rem, 7svh, 4rem));
				}

				.title {
					font-size: clamp(2.75rem, 12vw, 4.5rem);
				}

				.row {
					grid-template-columns: 1fr;
					row-gap: 1rem;
				}

				.row > .eyebrow {
					padding-top: 0;
				}
			}

			@media (max-width: 34rem) {
				.form {
					grid-template-columns: 1fr;
					gap: 1.25rem;
				}

				.form .submit {
					justify-self: start;
				}

				.good .finding {
					grid-template-columns: 1fr;
				}
			}

			/* ---------- Entradas, como en /contacto ---------- */
			@media (prefers-reduced-motion: no-preference) {
				.title {
					animation: focus-in 0.9s var(--ease-out) 0.05s both;
				}

				.hero .eyebrow,
				.lead {
					animation: rise-in 0.8s var(--ease-out) 0.2s both;
				}

				.form,
				.hint {
					animation: rise-in 0.8s var(--ease-out) 0.35s both;
				}

				/* El resultado entra como una observación que se confirma: de
				   desenfocado a enfocado, fila a fila */
				.result:not([hidden]) .row {
					animation: focus-in 0.8s var(--ease-out) both;
				}

				.result .row:nth-child(2) {
					animation-delay: 0.08s;
				}

				.result .row:nth-child(3) {
					animation-delay: 0.16s;
				}

				.result .row:nth-child(n + 4) {
					animation-delay: 0.24s;
				}
			}

			@keyframes focus-in {
				from {
					opacity: 0;
					filter: blur(10px);
					translate: 0 0.4rem;
				}
			}

			@keyframes rise-in {
				from {
					opacity: 0;
					translate: 0 0.6rem;
				}
			}
		</style>
	</body>
</html>
